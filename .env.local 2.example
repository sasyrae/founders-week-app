# ─────────────────────────────────────────────────────────────
# Flybridge Founders Week app — environment variables
# Copy this file to .env.local for local dev, and set the SAME
# names in the Vercel dashboard (Project → Settings → Environment
# Variables) for production. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Supabase dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service role key is a SECRET — server-only, full DB access. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin access (Host tools) ---
# A single shared password that unlocks the /admin Host tools. Choose a strong one.
ADMIN_PASSWORD=change-me-to-something-strong
# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=another-long-random-string

# --- Resend (transactional email) ---
# From Resend dashboard → API Keys.
RESEND_API_KEY=re_your_api_key
# The verified from-address. Must be on a domain you verified in Resend.
CONFIRM_FROM_EMAIL=Flybridge Founders Week <founders-week@flybridge.com>

# --- Slack (optional cross-post of admin updates) ---
# An Incoming Webhook URL from Slack. Leave blank to disable cross-posting.
SLACK_WEBHOOK_URL=

# --- Public site URL (used in emails / links). Set to the Vercel/prod URL. ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
